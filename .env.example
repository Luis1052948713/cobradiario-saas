# Cobra Diario SaaS - environment example
# Copy this file to .env locally if you use local tooling.
# Do not commit real secrets.

APP_ENV=development
APP_NAME=Cobra Diario

# Supabase public client configuration.
# Flutter must only use anon/public values, never service role keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Stripe public key for client-side flows.
# Secret keys and webhook secrets must live only in backend/Edge Functions.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Web/admin deployment URLs.
WEB_BASE_URL=http://localhost:3000
STAGING_WEB_URL=https://staging.example.com
PRODUCTION_WEB_URL=https://app.example.com

# Optional support and update controls.
SUPPORT_EMAIL=soporte@example.com
MIN_SUPPORTED_VERSION=1.0.0
RECOMMENDED_VERSION=1.0.0
